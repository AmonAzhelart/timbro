# ============================================================
# Timbro - configurazione iniziale
#
# Copia questo file in `.env`. Compilare HF_TOKEN qui è opzionale:
# puoi inserirlo anche dall'interfaccia (⚙ Impostazioni), che è il
# modo consigliato.
#
# PRECEDENZA DEI VALORI:
#   default nel codice  <  questo file  <  impostazioni da interfaccia
#
# Ciò che modifichi dalla UI viene salvato in `data/settings.json` e
# ha la meglio su quanto scritto qui. Riportando un campo al valore
# di questo file, l'override sparisce automaticamente.
# ============================================================

# --- Hugging Face (OBBLIGATORIO per la diarizzazione) -------
# Token gratuito: https://huggingface.co/settings/tokens  (tipo "Read")
# Devi anche ACCETTARE le condizioni d'uso dei modelli, altrimenti
# la diarizzazione gira ma restituisce speaker vuoti:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/segmentation-3.0
# Puoi lasciarlo vuoto e inserirlo da ⚙ Impostazioni, dove trovi
# anche un pulsante "Verifica" che controlla token e accesso ai repo.
HF_TOKEN=

# --- WhisperX ------------------------------------------------
# tiny | base | small | medium | large-v2 | large-v3 | large-v3-turbo
# large-v3      -> ~10 GB VRAM, qualità massima (default)
# large-v3-turbo-> ~6 GB VRAM, molto più veloce ma perde accuratezza su audio
#                  rumoroso, accenti marcati e frasi che mescolano più lingue
# medium        -> ~5 GB VRAM
WHISPER_MODEL=large-v3

# float16 (GPU moderne) | int8_float16 (meno VRAM) | int8 (CPU)
WHISPER_COMPUTE_TYPE=float16

# Abbassa se vai in OOM (16 va bene su >=10 GB VRAM)
WHISPER_BATCH_SIZE=16

# Lingua audio: it, en, ... oppure "auto" per rilevamento automatico
WHISPER_LANGUAGE=it

# Modello di diarizzazione pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# --- Qualità della trascrizione ------------------------------
# NB: argomento della riunione, termini ricorrenti e numero di partecipanti
# NON si configurano qui. Cambiano da un incontro all'altro, quindi si
# indicano al caricamento del file, sotto "Dettagli di questa riunione".

# Ampiezza di ricerca: 5 default, 8 aiuta su audio difficile (più lento)
BEAM_SIZE=5

# Sotto questa probabilità uno spezzone è considerato silenzio.
# Abbassa a 0.4 se perde frasi dette a voce bassa.
NO_SPEECH_THRESHOLD=0.6

# Sensibilità del rilevamento del parlato (più basso = più permissivo)
VAD_ONSET=0.500
VAD_OFFSET=0.363

# Rileva la lingua spezzone per spezzone: utile solo su audio che alterna
# davvero più lingue, altrimenti è solo più lento.
MULTILINGUAL=false

# Passa-alto + riduzione rumore + livellamento volumi prima della trascrizione.
# Consigliato su registrazioni ambientali con microfono lontano.
AUDIO_PREPROCESS=false

# Ricognizione automatica: un primo passaggio veloce su alcuni minuti campionati
# deduce argomento e vocabolario, che vengono usati per la trascrizione vera.
# Aggiunge 15-30 secondi al job. Quello che deduce è ispezionabile e correggibile
# nella scheda "Contesto" del job.
AUTO_CONTEXT=true

# --- Ollama --------------------------------------------------
# Consigliati per riassunti in italiano:
#   qwen3:8b        ~6 GB VRAM  - ottimo rapporto qualità/peso (default)
#   qwen3:14b       ~10 GB VRAM - più accurato sugli action point
#   gemma3:12b      ~9 GB VRAM  - molto buono sul multilingua
#   llama3.1:8b     ~5 GB VRAM  - alternativa leggera
OLLAMA_MODEL=qwen3:8b

# Finestra di contesto del modello (token). 32768 copre ~1h di riunione
# in un colpo solo; se vai in OOM scendi a 16384.
OLLAMA_NUM_CTX=32768

# Caratteri per chunk nella fase "map" del riassunto di riunioni lunghe
CHUNK_CHARS=12000

# --- App -----------------------------------------------------
API_PORT=8080

# Dimensione massima file upload in MB
MAX_UPLOAD_MB=1024

# Cancella l'audio originale dopo l'elaborazione (true/false)
DELETE_AUDIO_AFTER=false
